# FDB-v3 LiveKit agent. The planner, LiveKit server and benchmark evaluator run
# outside this image. Mount only the public contract and recognizer model.
# THREAD_FDB3_WHISPER_MODEL selects base.en|small.en at runtime; the only default
# and both verified pin sets are in config/fdb3-candidate.json (not baked here).
FROM python:3.11.16-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS cpu

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/thread \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    THREAD_FDB3_PROFILE=cpu-component \
    THREAD_FDB3_CONTRACT=/assets/contract \
    THREAD_FDB3_WHISPER=/assets/whisper \
    THREAD_FDB3_TELEMETRY=/evidence/agent_tool_calls.log \
    THREAD_FDB3_JOURNAL_DIR=/evidence/journals \
    THREAD_FDB3_TTS_PROFILE=espeak-ng \
    THREAD_FDB3_TTS_COMMAND='["espeak-ng","-w","{output}","-f","{text_file}"]'

WORKDIR /opt/thread
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg espeak-ng libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 thread \
    && mkdir /evidence \
    && chown thread:thread /evidence
COPY requirements-fdb3.lock ./
RUN python -m pip install --no-cache-dir -r requirements-fdb3.lock \
    && python -m pip check
COPY participant/ ./participant/
COPY thread_agent/ ./thread_agent/
COPY config/fdb3-candidate.json ./config/
COPY scripts/fdb3_agent.py scripts/fdb3_config.py scripts/fdb3_linux_smoke.py ./scripts/
USER thread
ENTRYPOINT ["python", "scripts/fdb3_agent.py"]
CMD ["start"]

# The default target is the measured CUDA recognition profile. Planner and
# LiveKit are still external; this is not an all-in-one benchmark image.
FROM cpu AS cuda
USER root
COPY requirements-fdb3-cuda.txt ./
RUN python -m pip install --no-cache-dir -r requirements-fdb3-cuda.txt \
    && python -m pip check
ENV THREAD_FDB3_PROFILE=candidate \
    LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib
USER thread
