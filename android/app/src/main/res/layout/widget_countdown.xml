<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/countdown_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:orientation="vertical">
 <TextView android:id="@+id/countdown_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCD8EA" android:textSize="15sp"/>
 <Chronometer android:id="@+id/countdown_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="42sp" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:countDown="true"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Visual countdown · no alarm sound" android:textColor="#9CACC0" android:textSize="10sp"/>
</LinearLayout>
