<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/clocks_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="18dp" android:gravity="center_vertical">
 <LinearLayout android:id="@+id/clock_one" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/clock_one_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#C5D1E2"/>
  <TextClock android:id="@+id/clock_one_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="38sp" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:textColor="#FFFFFF"/>
  <TextClock android:id="@+id/clock_one_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:format12Hour="EEE, d MMM · z" android:format24Hour="EEE, d MMM · z" android:textSize="10sp" android:textColor="#96A8C0"/>
 </LinearLayout>
 <TextView android:id="@+id/clock_divider" android:layout_width="1dp" android:layout_height="78dp" android:layout_marginHorizontal="16dp" android:background="#344153"/>
 <LinearLayout android:id="@+id/clock_two" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/clock_two_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#C5D1E2"/>
  <TextClock android:id="@+id/clock_two_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="38sp" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:textColor="#FFFFFF"/>
  <TextClock android:id="@+id/clock_two_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:format12Hour="EEE, d MMM · z" android:format24Hour="EEE, d MMM · z" android:textSize="10sp" android:textColor="#96A8C0"/>
 </LinearLayout>
</LinearLayout>
