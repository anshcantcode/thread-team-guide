<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THREAD" android:textColor="#C1CEE0" android:textSize="10sp" android:letterSpacing="0.25"/>
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:layout_marginStart="12dp" android:maxLines="1" android:ellipsize="end" android:textColor="#9FADC0" android:textSize="11sp"/>
 </LinearLayout>
 <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="none" android:listSelector="@android:color/transparent" android:clipToPadding="false"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#91A0B6" android:textSize="9sp"/>
  <ImageButton android:id="@+id/widget_edit" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_widget_edit" android:background="@android:color/transparent" android:contentDescription="Edit widget"/>
  <ImageButton android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_refresh" android:background="@android:color/transparent" android:contentDescription="Refresh widget"/>
 </LinearLayout>
</LinearLayout>
