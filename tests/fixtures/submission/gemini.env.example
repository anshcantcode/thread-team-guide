# Copy only to a private file outside an immutable judge package.
# Setup: docs/GEMINI_SETUP.md. Offline check: scripts/check_gemini_config.py.
THREAD_PROVIDER=gemini
THREAD_MODEL=gemini-3.5-flash-lite
THREAD_API_KEY=

# Browser/Android conversation model; separate from the planning model above.
THREAD_LIVE_MODEL=gemini-3.1-flash-live-preview
THREAD_LIVE_VOICE=Kore
THREAD_LIVE_SEARCH=false
THREAD_TIMEZONE=Asia/Kolkata
THREAD_PORT=8766

# Official participant: explicitly point PARTICIPANT_ENV_FILE to this file.
# These options do not change browser/Android planning or Live generation.
# Reproducible setup candidate; live qualification is still required.
PARTICIPANT_THINKING_LEVEL=minimal
PARTICIPANT_TIMEOUT_SECONDS=4.5
PARTICIPANT_PREWARM=0
PARTICIPANT_IMAGE_EMBEDDING=1
PARTICIPANT_AUDIO_MODE=independent
